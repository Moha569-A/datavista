# ─────────────────────────────────────────────────────────────
# DataVista API — copy to .env and adjust. Never commit real secrets.
# ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8787
CLIENT_ORIGIN=http://localhost:5173

# Database
#   pglite -> embedded engine, zero setup (development / CI)
#   pg     -> PostgreSQL server (staging / production)
DB_DRIVER=pglite
PGLITE_DIR=./.data/pglite
DATABASE_URL=postgresql://datavista:datavista@localhost:5432/datavista
PG_POOL_MAX=10

# Sessions
JWT_SECRET=replace-with-32-plus-random-characters
SESSION_COOKIE=dv_session
SESSION_TTL_HOURS=8

# Storage (private local directory; swap lib/storage.js for S3 in production)
STORAGE_DIR=./.data/storage
MAX_UPLOAD_MB=20
MAX_ROWS=50000
SIGNED_URL_TTL=300

# Analytics service
ANALYTICS_URL=http://127.0.0.1:8788
ANALYTICS_SERVICE_TOKEN=dev-analytics-token

# Rate limiting
AUTH_RATE_LIMIT=20
API_RATE_LIMIT=600

# Seed demo accounts on first boot (set false in production)
AUTO_SEED=true
DEMO_PASSWORD=DataVista123
